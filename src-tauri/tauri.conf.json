{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineMotion Studio",
  "version": "0.8.2",
  "identifier": "com.stotian.minemotion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MineMotion Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "additionalBrowserArgs": "--enable-unsafe-swiftshader --ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "minemotion"
        ],
        "name": "MineMotion Project",
        "description": "MineMotion Studio project",
        "role": "Editor"
      },
      {
        "ext": [
          "minemotion-vfx"
        ],
        "name": "MineMotion VFX Package",
        "description": "MineMotion Studio VFX package",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
